# Python
__pycache__/
*.py[cod]
# The venv really lives in .venv.nosync (iCloud-excluded — iCloud stamps
# UF_HIDDEN on Desktop files, and CPython >=3.11 silently skips hidden .pth
# files, breaking the editable install); .venv is a local symlink to it.
# No trailing slash: the pattern must match the symlink.
.venv
.venv.nosync/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/

# macOS
.DS_Store

# Local-only assets. The clip corpus lives on an external drive (Steven's:
# /Volumes/T7/pool_room_clips); tests/clips is a local symlink to it so every
# code/doc path keeps working — see tests/README.md. No trailing slash: the
# pattern must match the symlink. Clips are never published.
models/
tests/clips
.env

# Detector output cached for corpus replays (`pytest --detect-cache`).
# Derived, machine-specific, and rebuildable from the clips. `.nosync` keeps
# iCloud off it — see the note in capture/detect_cache.py.
.detect-cache.nosync/

# Mount-specific calibration artifacts (refit after every camera move)
config/

# Session logs
logs/

# Working copy of a retired implementation plan. docs/accuracy-plan.md drove
# checkpoints 53-58 and was deleted once they landed (its reasoning lives in
# those CHANGELOG entries and in design.md). Ignored so a local copy can be
# kept without it creeping back into the repo.
docs/accuracy-plan.md

# Golden diffs from the last corpus run — per-run output, not a record.
# Written by tests/corpus/goldens.py so a truncated capture never costs a rerun.
tests/goldens/.failures/
