# Python
__pycache__/
*.py[cod]
# The venv really lives in .venv.nosync (iCloud-excluded, same reason as
# tests/clips.nosync — iCloud stamped UF_HIDDEN on .pth files, which
# CPython >=3.11 silently skips, breaking the editable install); .venv is a
# local symlink to it. No trailing slash: the pattern must match the symlink.
.venv
.venv.nosync/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/

# macOS
.DS_Store

# Local-only assets. Clips live in clips.nosync (the .nosync suffix excludes
# them from iCloud Drive sync — Desktop is synced on this Mac, and iCloud
# retry-looped forever trying to upload 47 GB of corpus); tests/clips is a
# tracked symlink so every code/doc path keeps working.
models/
tests/clips.nosync/*
!tests/clips.nosync/README.md
.env

# Mount-specific calibration artifacts (refit after every camera move)
config/

# Steven's personal scratch notes
docs/accuracy-ideas.md
